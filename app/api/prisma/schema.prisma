generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  about     String?
  photoUrl  String?
  
  // 2-Step Verification
  isVerified         Boolean   @default(false)
  verificationCode   String?
  verificationExpiry DateTime?
  resetToken         String?
  resetTokenExpiry   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cats           Cat[]
  schedules      Schedule[]
  contacts       Contact[]
  inventoryItems InventoryItem[]
}

model Cat {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  name        String
  nickname    String?
  breed       String?
  gender      String   // Male, Female
  weight      Float?
  birthDate   DateTime?
  color       String?
  eyeColor    String?
  features    String?
  isSpayed    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  photoUrl    String?

  // Lineage (Self-relations for Parents)
  motherId    String?
  mother      Cat?     @relation("MotherChildren", fields: [motherId], references: [id])
  childrenMother Cat[] @relation("MotherChildren")

  fatherId    String?
  father      Cat?     @relation("FatherChildren", fields: [fatherId], references: [id])
  childrenFather Cat[] @relation("FatherChildren")

  // Lineage (Relation to Litter as a Child)
  litterId    String?
  litter      Litter?  @relation("LitterKittens", fields: [litterId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  healthEvents   HealthEvent[]
  adoptions      AdoptionRecord[]
  
  // Lineage (Relation to Litters as a Parent)
  litters        Litter[]      @relation("MotherLitters")
  littersSired   Litter[]      @relation("FatherLitters")
  
  schedules      Schedule[]
  inventoryItems InventoryItem[]
  weightLogs     WeightLog[]
}

model WeightLog {
  id        String   @id @default(uuid())
  catId     String
  cat       Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  weight    Float
  date      DateTime @default(now())
}

model HealthEvent {
  id            String   @id @default(uuid())
  catId         String
  cat           Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  title         String
  eventType     String
  notes         String?
  diagnosis     String?
  attachmentUrl String?
  date          DateTime
  createdAt     DateTime @default(now())
}

model Schedule {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cats          Cat[]    
  taskName      String
  time          String
  recurrence    String
  lastCompleted DateTime?
  createdAt     DateTime @default(now())
}

model Contact {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  role      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  
  adoptions AdoptionRecord[]
}

model AdoptionRecord {
  id          String   @id @default(uuid())
  catId       String
  cat         Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  date        DateTime
  type        String
  adopterName String?
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  notes       String?
  createdAt   DateTime @default(now())
}

model Litter {
  id          String   @id @default(uuid())
  
  // Parents
  motherId    String
  mother      Cat      @relation("MotherLitters", fields: [motherId], references: [id])
  fatherId    String?
  father      Cat?     @relation("FatherLitters", fields: [fatherId], references: [id])
  
  dateOfBirth DateTime
  kittenCount Int
  notes       String?
  
  // Children (The fix: Named relation to match Cat.litter)
  kittens     Cat[]    @relation("LitterKittens")
  
  createdAt   DateTime @default(now())
}

model InventoryItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String
  quantity  Float
  unit      String
  threshold Float?
  cats      Cat[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}