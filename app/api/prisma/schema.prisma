// api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  about     String?
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cats           Cat[]
  schedules      Schedule[]
  contacts       Contact[]
  inventoryItems InventoryItem[]
}

model Cat {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  name        String
  nickname    String?
  breed       String?
  gender      String   // Male, Female
  weight      Float?
  birthDate   DateTime?
  color       String?
  eyeColor    String?
  features    String?
  isSpayed    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  photoUrl    String?

  motherId    String?
  mother      Cat?     @relation("MotherChildren", fields: [motherId], references: [id])
  childrenMother Cat[] @relation("MotherChildren")

  fatherId    String?
  father      Cat?     @relation("FatherChildren", fields: [fatherId], references: [id])
  childrenFather Cat[] @relation("FatherChildren")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  healthEvents   HealthEvent[]
  adoptions      AdoptionRecord[]
  
  // Litter Relations
  litterId       String?
  litter         Litter?       @relation(fields: [litterId], references: [id])
  
  litters        Litter[]      @relation("MotherLitters")
  littersSired   Litter[]      @relation("FatherLitters")
  
  schedules      Schedule[]
  inventoryItems InventoryItem[]
}

model HealthEvent {
  id            String   @id @default(uuid())
  catId         String
  cat           Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  title         String
  eventType     String   // Vaccination, Surgery, etc.
  notes         String?
  diagnosis     String?
  attachmentUrl String?  // X-Ray, Lab Result photo
  date          DateTime
  createdAt     DateTime @default(now())
}

model Schedule {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cats       Cat[]    // Linked to multiple cats
  
  taskName   String
  time       String
  recurrence String   // Once, Daily, Weekly, Monthly
  createdAt  DateTime @default(now())
}

model Contact {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  role      String   // Vet, Breeder, Owner
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  
  adoptions AdoptionRecord[] // Back relation
}

model AdoptionRecord {
  id          String   @id @default(uuid())
  catId       String
  cat         Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  date        DateTime
  type        String   // Adoption, Transfer, Rehoming
  adopterName String?
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  notes       String?
  createdAt   DateTime @default(now())
}

model Litter {
  id          String   @id @default(uuid())
  motherId    String
  mother      Cat      @relation("MotherLitters", fields: [motherId], references: [id])
  fatherId    String?
  father      Cat?     @relation("FatherLitters", fields: [fatherId], references: [id])
  dateOfBirth DateTime
  kittenCount Int
  notes       String?
  
  kittens     Cat[]    // Relation to the actual kitten profiles
  
  createdAt   DateTime @default(now())
}

model InventoryItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name      String
  category  String   // Food, Meds, Toy, etc.
  quantity  Float
  unit      String   // kg, pcs, cans
  threshold Float?   // Low stock alert
  
  cats      Cat[]    // Linked to multiple cats
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}