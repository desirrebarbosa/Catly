generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  name           String?
  phone          String?
  about          String?
  photoUrl       String?
  
  // 2FA Security
  is2FAEnabled    Boolean  @default(false)
  twoFactorSecret String?
  
  // Password Reset
  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cats           Cat[]
  schedules      Schedule[]
  contacts       Contact[]
  inventoryItems InventoryItem[]
}

model Cat {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  name        String
  nickname    String?
  breed       String?
  gender      String   // Male, Female
  weight      Float?
  birthDate   DateTime?
  color       String?
  eyeColor    String?
  features    String?  // Bio/Notes
  photoUrl    String?
  
  isSpayed    Boolean  @default(false)
  isArchived  Boolean  @default(false) // For auto-archiving inactive cats

  // Lineage (Parents)
  motherId    String?
  mother      Cat?     @relation("MotherToChild", fields: [motherId], references: [id])
  childrenMother Cat[] @relation("MotherToChild")

  fatherId    String?
  father      Cat?     @relation("FatherToChild", fields: [fatherId], references: [id])
  childrenFather Cat[] @relation("FatherToChild")

  // Litter logic
  litterId    String?
  litter      Litter?  @relation("LitterKittens", fields: [litterId], references: [id])
  
  // Parent of Litters
  littersMother Litter[] @relation("MotherLitter")
  littersFather Litter[] @relation("FatherLitter")

  // Relations
  healthEvents  HealthEvent[]
  weightLogs    WeightLog[]
  adoptions     AdoptionRecord[]
  
  // Many-to-Many
  schedules     Schedule[]
  inventoryItems InventoryItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HealthEvent {
  id            String   @id @default(uuid())
  catId         String
  cat           Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  
  title         String
  eventType     String   // Vaccination, Surgery, etc.
  date          DateTime @default(now())
  diagnosis     String?
  notes         String?
  attachmentUrl String?  // Can store JSON string of multiple image URLs
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WeightLog {
  id        String   @id @default(uuid())
  catId     String
  cat       Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  
  weight    Float
  date      DateTime @default(now())
}

model Schedule {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  taskName          String
  time              String   // "08:00 AM" or ISO string
  recurrence        String   // Daily, Weekly
  lastCompletedDate DateTime? // For tracking daily completion checkmark
  
  cats              Cat[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Contact {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  name      String
  role      String   // Vet, Sitter, Adopter
  phone     String?
  email     String?
  
  adoptions AdoptionRecord[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdoptionRecord {
  id          String   @id @default(uuid())
  catId       String
  cat         Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  
  date        DateTime @default(now())
  type        String   // Adoption, Foster, Transfer
  adopterName String?
  notes       String?
  
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Litter {
  id          String   @id @default(uuid())
  
  motherId    String
  mother      Cat      @relation("MotherLitter", fields: [motherId], references: [id])
  
  fatherId    String?
  father      Cat?     @relation("FatherLitter", fields: [fatherId], references: [id])
  
  dateOfBirth DateTime
  kittenCount Int
  notes       String?
  
  kittens     Cat[]    @relation("LitterKittens")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventoryItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name      String
  category  String   // Food, Meds
  quantity  Float
  unit      String?
  threshold Float?   // Low stock alert
  
  cats      Cat[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}