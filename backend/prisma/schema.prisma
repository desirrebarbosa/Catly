generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")  // Add this line
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  phone        String?
  about        String?
  profilePhoto String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  cats         Cat[]    @relation("OwnerCats")
}

model Cat {
  id          String   @id @default(uuid())
  name        String
  breed       String?
  gender      String   // "Male" or "Female"
  birthDate   DateTime?
  weight      Float?   // in kg
  color       String?
  microchipId String?
  photoUrl    String?
  isSpayed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Owner Relation
  ownerId     String
  owner       User     @relation("OwnerCats", fields: [ownerId], references: [id])

  // Medical History
  medicalRecords MedicalRecord[]

  // Lineage (Self-referencing relations)
  motherId    String?
  mother      Cat?     @relation("KittenToMother", fields: [motherId], references: [id])
  motherOf    Cat[]    @relation("KittenToMother")

  fatherId    String?
  father      Cat?     @relation("KittenToFather", fields: [fatherId], references: [id])
  fatherOf    Cat[]    @relation("KittenToFather")
}

model MedicalRecord {
  id          String   @id @default(uuid())
  title       String   // e.g. "Vaccination", "Checkup"
  date        DateTime @default(now())
  notes       String?
  veterinarian String?
  nextDueDate DateTime? // For reminders

  // Relations
  catId       String
  cat         Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
}